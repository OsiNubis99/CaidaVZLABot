# Telegram bot token from @BotFather
TELEGRAM_TOKEN=replace_with_bot_token

# Postgres
DB_USER=caida
DB_PASSWORD=replace_with_strong_random_password
DB_NAME=caida
PGSSL=false

# Comma-separated list of Telegram user_ids that can use /admin and
# privileged commands (/message, /lock, /unlock, /addg, /paid, /stats).
# This file is committed; the value below is the bot author and is public.
ADMIN_USER_IDS=114083702

# Logging level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Optional: enable the /stats dashboard. Pick a random opaque string,
# then visit http://<host>:3000/stats?token=<STATS_TOKEN>.
# Leave empty to disable the route entirely.
STATS_TOKEN=

# Admin dashboard (web). Set _SECRET and _BASE_URL to enable.
# JWT secret: 32+ random bytes (e.g. `openssl rand -hex 32`).
# Base URL: public URL where the dashboard is reachable; the magic
# link the bot DMs is built from this. Must include the public path
# prefix if any (e.g. https://server.codeaver.com/caidavzlabot).
# Path: URL prefix the Express app mounts at — MUST match the public
# path (nginx proxies same prefix, no rewrite). Default /dashboard.
DASHBOARD_JWT_SECRET=
DASHBOARD_BASE_URL=
DASHBOARD_PATH=/dashboard
